# ============================================================
# Variáveis de ambiente do Bolão da Copa 2026
# ============================================================
# Este é um TEMPLATE. Copie para `.env` e edite os valores.
# Nunca commite o `.env` real (está no .gitignore).

# -------- Banco de dados --------
# Em dev local (Windows/Mac/Linux): deixe comentado ou use SQLite
# DATABASE_URL=sqlite:///./bolao.db

# Em produção (Railway/Render/Fly): a plataforma seta isso automaticamente
# ao provisionar um Postgres gerenciado. Exemplo do formato:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# -------- Autenticação --------
# SECRET_KEY é usada pra assinar os JWTs.
# Gere uma aleatória em produção com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troca-isso-em-producao-por-string-aleatoria-longa

# Horas de validade do token de acesso
TOKEN_EXPIRE_HOURS=24

# -------- Admin --------
# Token fixo para endpoints admin (registrar resultados, controlar fases).
# Em produção: use uma string aleatória longa.
ADMIN_TOKEN=fumaobolaoadmin

# ==============================================================================
# 💳 PayPal Configuration (Sistema de Pagamentos)
# ==============================================================================

# Obter em: https://developer.paypal.com/dashboard/apps/sandbox
PAYPAL_CLIENT_ID=AH-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYPAL_CLIENT_SECRET=EC-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modo: "sandbox" (testes) ou "live" (produção)
# ATENÇÃO: Use "sandbox" para desenvolvimento!
PAYPAL_MODE=sandbox
